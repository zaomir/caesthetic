{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caesthetic.com/schemas/case-study.schema.json",
  "title": "CAESTHETIC Case Study Record",
  "type": "object",
  "required": [
    "id",
    "title",
    "summary",
    "industry",
    "country",
    "businessModel",
    "goals",
    "relevanceTier",
    "mediaId",
    "publicationState"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^case-[0-9]{2,}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 8 },
    "summary": { "type": "string", "minLength": 30 },
    "industry": { "type": "string", "minLength": 2 },
    "country": { "type": "string", "minLength": 2 },
    "businessModel": { "type": "string", "minLength": 2 },
    "practiceScale": { "type": "string", "minLength": 2 },
    "goals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["bookings", "conversion", "retention", "reputation", "multi-location"] }
    },
    "relevanceTier": { "enum": ["closest-match", "adjacent-model", "transferable-pattern"] },
    "applicability": { "type": "string", "minLength": 30 },
    "mediaId": { "type": "string", "minLength": 3 },
    "publicationState": {
      "enum": [
        "draft",
        "evidence_incomplete",
        "evidence_verified",
        "permission_pending",
        "legal_review",
        "approved",
        "publishable"
      ]
    },
    "linkedAudit": { "$ref": "#/$defs/linkedAudit" },
    "evidence": {
      "type": "object",
      "properties": {
        "baseline": { "$ref": "#/$defs/metricObservation" },
        "outcome": { "$ref": "#/$defs/metricObservation" },
        "measurementWindow": { "$ref": "#/$defs/period" },
        "budgetContext": { "type": "string", "minLength": 3 },
        "practiceContribution": { "type": "string", "minLength": 3 },
        "caestheticRole": { "type": "string", "minLength": 3 },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 8 }
        },
        "dataSource": { "type": "string", "minLength": 3 },
        "attribution": { "enum": ["direct", "contributory", "correlated", "not_claimed"] },
        "clientPermission": { "enum": ["pending", "approved", "denied"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "publicationState": { "const": "publishable" } } },
      "then": {
        "required": ["slug", "practiceScale", "applicability", "evidence"],
        "properties": {
          "evidence": {
            "required": [
              "baseline",
              "outcome",
              "measurementWindow",
              "budgetContext",
              "practiceContribution",
              "caestheticRole",
              "limitations",
              "dataSource",
              "attribution",
              "clientPermission"
            ],
            "properties": {
              "clientPermission": { "const": "approved" }
            }
          },
          "linkedAudit": {
            "allOf": [
              {
                "if": {
                  "required": ["accessLevel"],
                  "properties": { "accessLevel": { "enum": ["public_redacted", "request_nda"] } }
                },
                "then": {
                  "required": ["title", "url", "permission", "redactionStatus", "reviewedDate", "redaction"],
                  "properties": {
                    "url": { "type": "string", "format": "uri", "pattern": "^https://" },
                    "permission": { "const": "approved" },
                    "redactionStatus": { "const": "verified" },
                    "redaction": {
                      "required": ["identifiersRemoved", "patientDataRemoved", "linksReviewed", "screenshotsReviewed", "metadataRemoved"],
                      "properties": {
                        "identifiersRemoved": { "const": true },
                        "patientDataRemoved": { "const": true },
                        "linksReviewed": { "const": true },
                        "screenshotsReviewed": { "const": true },
                        "metadataRemoved": { "const": true }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "linkedAudit": {
      "type": "object",
      "required": ["accessLevel"],
      "properties": {
        "accessLevel": { "enum": ["public_redacted", "request_nda", "internal_only"] },
        "title": { "type": "string", "minLength": 8 },
        "url": { "type": "string" },
        "pageCount": { "type": "integer", "minimum": 1 },
        "permission": { "enum": ["pending", "approved", "denied"] },
        "redactionStatus": { "enum": ["pending", "verified", "failed"] },
        "reviewedDate": { "type": "string", "format": "date" },
        "redaction": {
          "type": "object",
          "properties": {
            "identifiersRemoved": { "type": "boolean" },
            "patientDataRemoved": { "type": "boolean" },
            "linksReviewed": { "type": "boolean" },
            "screenshotsReviewed": { "type": "boolean" },
            "metadataRemoved": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "metricObservation": {
      "type": "object",
      "required": ["metric", "value", "unit", "denominator", "period"],
      "properties": {
        "metric": { "type": "string", "minLength": 3 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "denominator": { "type": "number", "exclusiveMinimum": 0 },
        "period": { "$ref": "#/$defs/period" },
        "display": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
